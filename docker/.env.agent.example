# Copy to docker/.env and fill in, then:
#   docker compose -f docker-compose.agent.yml up -d

# WebDAV backend — the same server, credentials and sync folder the Obsidian
# plugin uses. With the bundled test backend (docker-compose.yml) that is
# http://webdav:80 from inside the compose network, or http://<host>:8080 from outside.
SELFSYNC_WEBDAV_URL=https://webdav.example.com/remote.php/dav/files/me
SELFSYNC_WEBDAV_USER=selfsync
SELFSYNC_WEBDAV_PASS=change-me-please
SELFSYNC_WEBDAV_ROOT_DIR=selfsync

# Only if the vault is end-to-end encrypted. Must match the plugin's passphrase
# exactly. Leave empty for an unencrypted vault — a mismatch is refused, not guessed.
SELFSYNC_ENCRYPTION_PASSPHRASE=

# Timing. The watcher pushes local edits after CHANGE_DEBOUNCE_SECONDS of quiet,
# subject to a 30s cooldown between automatic syncs; the interval is the backstop
# that also pulls remote changes.
SELFSYNC_SYNC_INTERVAL_MINUTES=5
SELFSYNC_CHANGE_DEBOUNCE_SECONDS=10

# Files larger than this are left untouched on both sides (uploads are read whole
# into memory). 0 = no limit.
SELFSYNC_MAX_FILE_MB=50

SELFSYNC_DEBUG=false

# Image for the agent container that works on the vault.
AGENT_IMAGE=node:26
