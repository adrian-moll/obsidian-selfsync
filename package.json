{
  "name": "obsidian-selfsync",
  "version": "0.17.10",
  "description": "Self-hosted, bring-your-own-backend sync and backup for Obsidian.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "dev:cli": "node esbuild.cli.config.mjs",
    "build:cli": "tsc --noEmit --skipLibCheck && node esbuild.cli.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "keywords": [
    "obsidian",
    "sync",
    "webdav",
    "backup"
  ],
  "author": "Adrian Moll",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.7",
    "obsidian": "^1.14.4",
    "tslib": "^2.9.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "isomorphic-git": "^1.44.10",
    "node-diff3": "^3.2.1"
  }
}
